---
import { Picture } from 'astro:assets';
import teaching from '../assets/teaching-robotics.png';
import type { SiteContent } from '../data/types';

interface Props {
  t: SiteContent;
}

const { t } = Astro.props;
---

<figure class="band">
  <Picture
    src={teaching}
    alt={t.teachingBand.alt}
    widths={[640, 960, 1280, 1488]}
    sizes="(min-width: 78rem) 1152px, 100vw"
    formats={['avif', 'webp']}
    fallbackFormat="webp"
    quality={82}
    loading="lazy"
    decoding="async"
  />
  <figcaption>
    <p class="caption">{t.teachingBand.caption}</p>
    <p class="place">{t.teachingBand.place}</p>
  </figcaption>
</figure>

<style>
  /*
    The source is 1488x837. It was previously full-bleed, which asked a 1488px
    photograph to fill a 1920px viewport and made it visibly soft. It is now
    contained to the site's 72rem column, so on every screen it is displayed at
    or below its native width and stays sharp; the largest variant requested is
    its own resolution, never more.
  */
  .band {
    margin: 0;
    border-top: 1px solid var(--color-line);
    padding: 3.5rem 1rem;
    max-width: 72rem;
    margin-inline: auto;
  }
  .band :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 2px;
  }
  figcaption {
    padding: 1.25rem 0 0;
  }
  .caption {
    margin: 0;
    max-width: 34em;
    font-size: 1.125rem;
  }
  .place {
    margin: 0.35rem 0 0;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    color: var(--color-muted);
  }
  @media (min-width: 40rem) {
    .band {
      padding-left: 2rem;
      padding-right: 2rem;
    }
  }
</style>
