---
import type { CaseStudy } from '../data/types';

interface Props {
  video: CaseStudy['video'];
  lang: string;
}

const { video, lang } = Astro.props;

/*
  The clip is a 3x2 mosaic with its own labels burned in, so the key below mirrors
  that grid rather than overlaying it — same reading order, no duplicated text, and
  it still works when the video is paused or blocked.
*/
const dec = (n: number, d: number) => {
  const s = n.toFixed(d);
  return lang === 'fr' ? s.replace('.', ',') : s;
};
---

<div class="compare">
  <video
    src={video.src}
    data-autoplay
    muted
    loop
    playsinline
    preload="metadata"
    controls
    aria-label={video.caption}></video>

<script is:inline>
  /* Autoplay is applied from script rather than markup so that a visitor who has
     asked for reduced motion gets a paused first frame and the controls, instead
     of eighty seconds of movement they did not ask for. */
  (() => {
    const v = document.currentScript.previousElementSibling;
    if (!v || v.tagName !== 'VIDEO') return;
    const still = window.matchMedia('(prefers-reduced-motion: reduce)');
    const apply = () => {
      if (still.matches) {
        v.autoplay = false;
        v.pause();
      } else {
        v.autoplay = true;
        v.play().catch(() => {});
      }
    };
    apply();
    still.addEventListener('change', apply);
  })();
</script>

  <p class="caption">{video.caption}</p>

  <h3 class="key-title">{video.keyTitle}</h3>
  <ol class="key">
    {
      video.panels.map((p) => (
        <li class:list={['panel', { budget: p.budget }]}>
          <span class="variant">{p.variant}</span>
          <span class="figures">
            <span class="coverage">{dec(p.coverage, 2)}</span>
            <span class="steps">{p.steps} {video.stepsLabel}</span>
          </span>
          {p.budget && <span class="flag">{video.budgetNote}</span>}
        </li>
      ))
    }
  </ol>
</div>

<style>
  .compare video {
    width: 100%;
    height: auto;
    display: block;
    background: var(--color-ink);
    border-radius: 2px;
  }
  .caption {
    margin: 1rem 0 0;
    max-width: 44em;
    font-size: 1rem;
    color: var(--color-muted);
  }
  .key-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    margin: 2.5rem 0 1rem;
  }
  .key {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1px;
    background: var(--color-line);
    border: 1px solid var(--color-line);
    border-radius: 2px;
    overflow: hidden;
  }
  .panel {
    background: var(--color-paper);
    padding: 0.9rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .variant {
    font-family: var(--font-display);
    font-size: 1.125rem;
    line-height: 1.25;
  }
  .figures {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-variant-numeric: tabular-nums;
  }
  .coverage {
    font-family: var(--font-display);
    font-size: 1.75rem;
    color: var(--color-teal);
    line-height: 1;
  }
  .steps {
    font-size: 1rem;
    color: var(--color-muted);
  }
  .budget .coverage {
    color: var(--color-muted);
  }
  .flag {
    font-size: 0.95rem;
    line-height: 1.35;
    color: var(--color-signal);
  }

  /* Mirror the clip's own 3x2 mosaic once there is room for three columns. */
  @media (min-width: 36rem) {
    .key {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 56rem) {
    .key {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
