---
interface Props {
  title: string;
  caption: string;
  roundLabel: string;
  series: { name: string; values: (number | null)[] }[];
  lang: string;
}

const { title, caption, roundLabel, series, lang } = Astro.props;

/*
  Two series over four rounds. A line chart is right here: the point is that both
  curves fall monotonically, which is a shape, not a set of magnitudes. The y axis
  is truncated to 0.72–1.0 — legitimate for lines, where position encodes value and
  nothing is being read as a length.
*/
const W = 640;
const H = 300;
const PAD = { top: 16, right: 20, bottom: 44, left: 52 };
const Y_MIN = 0.72;
const Y_MAX = 1.0;
const rounds = [0, 1, 2, 3];

const x = (i: number) => PAD.left + (i / (rounds.length - 1)) * (W - PAD.left - PAD.right);
const y = (v: number) => PAD.top + (1 - (v - Y_MIN) / (Y_MAX - Y_MIN)) * (H - PAD.top - PAD.bottom);

const ticks = [0.75, 0.8, 0.85, 0.9, 0.95, 1.0];
const fmt = (n: number) => (lang === 'fr' ? n.toFixed(2).replace('.', ',') : n.toFixed(2));
const fmt3 = (n: number) => (lang === 'fr' ? n.toFixed(3).replace('.', ',') : n.toFixed(3));
const marks = ['var(--color-mark-a)', 'var(--color-mark-b)'];

const paths = series.map((s) =>
  s.values
    .map((v, i) => (v === null ? '' : `${i === 0 ? 'M' : 'L'}${x(i).toFixed(1)},${y(v).toFixed(1)}`))
    .join(' ')
    .trim(),
);
---

<figure class="chart">
  <figcaption><h3>{title}</h3></figcaption>

  <!-- Legend first: identity is never carried by colour alone. -->
  <ul class="legend">
    {
      series.map((s, si) => (
        <li>
          <span class="swatch" style={`background:${marks[si]}`} aria-hidden="true" />
          {s.name}
        </li>
      ))
    }
  </ul>

  <div class="plot">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={title} preserveAspectRatio="xMidYMid meet">
      {
        ticks.map((t) => (
          <>
            <line class="grid" x1={PAD.left} x2={W - PAD.right} y1={y(t)} y2={y(t)} />
            <text class="tick" x={PAD.left - 10} y={y(t)} text-anchor="end" dominant-baseline="middle">
              {fmt(t)}
            </text>
          </>
        ))
      }
      {
        rounds.map((r) => (
          <text class="tick" x={x(r)} y={H - PAD.bottom + 22} text-anchor="middle">
            {r}
          </text>
        ))
      }
      <text class="axis-label" x={(PAD.left + W - PAD.right) / 2} y={H - 6} text-anchor="middle">{roundLabel}</text>

      {
        series.map((s, si) => (
          <>
            <path class="line" d={paths[si]} style={`stroke:${marks[si]}`} />
            {s.values.map((v, i) =>
              v === null ? null : (
                <g>
                  <circle class="dot" cx={x(i)} cy={y(v)} r="5" style={`fill:${marks[si]}`} />
                  <title>{`${s.name}, ${roundLabel} ${i}: ${fmt3(v)}`}</title>
                </g>
              ),
            )}
            {/* Direct-label the end of each line rather than every point. */}
            <text
              class="end-label"
              x={x(s.values.length - 1) - 10}
              y={y(s.values[s.values.length - 1] as number) + (si === 0 ? 20 : -12)}
              text-anchor="end"
            >
              {fmt3(s.values[s.values.length - 1] as number)}
            </text>
          </>
        ))
      }
    </svg>
  </div>

  <p class="caption">{caption}</p>
</figure>

<style>
  .chart {
    margin: 0;
  }
  .chart h3 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0 0 0.75rem;
  }
  .legend {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0 0 1rem;
    padding: 0;
    font-size: 1rem;
    color: var(--color-muted);
  }
  .legend li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .swatch {
    width: 14px;
    height: 4px;
    border-radius: 2px;
  }
  .plot svg {
    width: 100%;
    height: auto;
  }
  .grid {
    stroke: var(--color-line);
    stroke-width: 1;
  }
  .tick,
  .axis-label {
    font-family: var(--font-display);
    font-size: 14px;
    fill: var(--color-muted);
  }
  .line {
    fill: none;
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .dot {
    /* 2px surface ring so overlapping marks stay separable. */
    stroke: var(--color-paper);
    stroke-width: 2;
  }
  .end-label {
    font-family: var(--font-display);
    font-size: 15px;
    font-variant-numeric: tabular-nums;
    fill: var(--color-ink);
  }
  .caption {
    margin: 1.25rem 0 0;
    max-width: 44em;
    font-size: 1rem;
    color: var(--color-muted);
  }
</style>
