---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class="border-t border-line">
  <div class="mx-auto grid max-w-6xl gap-6 px-4 py-14 sm:px-8 lg:grid-cols-12 lg:gap-10 lg:py-20">
    <h2 id={`${id}-title`} class="text-3xl sm:text-4xl lg:col-span-3 lg:sticky lg:top-24 lg:self-start">{title}</h2>
    <div class="lg:col-span-9">
      <slot />
    </div>
  </div>
</section>
