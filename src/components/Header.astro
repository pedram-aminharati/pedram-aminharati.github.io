---
import type { SiteContent } from '../data/types';

interface Props {
  t: SiteContent;
}

const { t } = Astro.props;
const links = [
  { href: '#about', label: t.nav.about },
  { href: '#work', label: t.nav.projects },
  { href: '#experience', label: t.nav.experience },
  { href: '#publications', label: t.nav.publications },
  { href: '#contact', label: t.nav.contact },
];
---

<header class="sticky top-0 z-10 border-b border-line bg-paper/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-6 px-4 sm:px-8">
    <a href={`/${t.lang}/`} class="font-display text-xl font-semibold no-underline">Pedram Aminharati</a>
    <nav aria-label="Main" class="flex items-center gap-6 font-display text-lg">
      <ul class="hidden gap-6 lg:flex">
        {links.map((l) => <li><a class="link no-underline hover:underline" href={l.href}>{l.label}</a></li>)}
      </ul>
      <a class="link hidden sm:inline" href="/cv/Pedram_Aminharati_CV_EN.pdf" download>{t.nav.downloadCv}</a>
      <a
        href={t.nav.switchTo.href}
        hreflang={t.nav.switchTo.href.slice(1, 3)}
        lang={t.nav.switchTo.href.slice(1, 3)}
        aria-label={t.nav.switchTo.name}
        class="rounded-[2px] border border-line px-2 py-0.5 font-medium no-underline hover:border-teal hover:text-teal"
      >{t.nav.switchTo.label}</a>
    </nav>
  </div>
</header>
