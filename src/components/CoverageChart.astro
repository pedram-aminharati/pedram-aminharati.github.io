---
import type { ResultRow } from '../data/types';

interface Props {
  title: string;
  caption: string;
  rows: ResultRow[];
  lang: string;
}

const { title, caption, rows, lang } = Astro.props;

/*
  Bars run from zero. Coverage only spans 0.60–0.96 here, so a truncated axis
  would make the gaps look far larger than they are; the direct labels carry the
  precision instead. Single measure, so one mark colour, with the teacher in the
  reference grey — no legend needed, the title names what is plotted.
*/
const sorted = [...rows].sort((a, b) => b.coverage - a.coverage);
const fmt = (n: number) => (lang === 'fr' ? n.toFixed(3).replace('.', ',') : n.toFixed(3));
---

<figure class="chart">
  <figcaption>
    <h3>{title}</h3>
  </figcaption>

  <ol class="rows">
    {
      sorted.map((r) => (
        <li class:list={['row', { teacher: r.teacher }]}>
          <span class="name">{r.variant}</span>
          <span class="track">
            <span class="bar" style={`width: ${(r.coverage * 100).toFixed(1)}%`}>
              <span class="sr-only">{fmt(r.coverage)}</span>
            </span>
          </span>
          <span class="value" aria-hidden="true">{fmt(r.coverage)}</span>
        </li>
      ))
    }
  </ol>

  <p class="caption">{caption}</p>
</figure>

<style>
  .chart {
    margin: 0;
  }
  .chart h3 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0 0 1.25rem;
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    /* 2px of surface between adjacent fills, so bars never touch. */
    gap: 0.75rem;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas: 'name value' 'track track';
    align-items: baseline;
    column-gap: 1rem;
    row-gap: 0.3rem;
  }
  .name {
    grid-area: name;
    font-size: 1rem;
    line-height: 1.3;
    color: var(--color-muted);
  }
  .value {
    grid-area: value;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-ink);
  }
  .track {
    grid-area: track;
    display: block;
    height: 10px;
    background: color-mix(in srgb, var(--color-line) 55%, transparent);
    border-radius: 2px;
  }
  .bar {
    display: block;
    height: 100%;
    background: var(--color-mark-a);
    /* Rounded data-end only, anchored to the baseline at zero. */
    border-radius: 0 2px 2px 0;
  }
  .teacher .bar {
    background: var(--color-mark-ref);
  }
  .teacher .name {
    color: var(--color-ink);
  }
  .caption {
    margin: 1.5rem 0 0;
    max-width: 44em;
    font-size: 1rem;
    color: var(--color-muted);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* From the small-tablet width up there is room for the label beside the bar. */
  @media (min-width: 40rem) {
    .row {
      grid-template-columns: 19rem 1fr 4rem;
      grid-template-areas: 'name track value';
      align-items: center;
      row-gap: 0;
    }
    .name {
      text-align: right;
    }
    .value {
      text-align: right;
    }
  }
</style>
